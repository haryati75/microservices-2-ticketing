{
  "name": "expiration",
  "version": "1.0.0",
  "description": "Microservices Ticketing App - Expiration Service",
  "author": "Haryati Hassan",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@charityx/common": "^1.0.14",
    "bull": "^4.16.5",
    "node-nats-streaming": "^0.3.2",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/bull": "^3.15.9",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
